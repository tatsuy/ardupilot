# Indoor SLAM-like setup (same as autotest VisionPosition) + proximity avoidance under test
GPS1_TYPE 0
VISO_TYPE 1
SERIAL5_PROTOCOL 1
EK3_SRC1_POSXY 6
EK3_SRC1_VELXY 6
EK3_SRC1_POSZ 6
EK3_SRC1_VELZ 6
AHRS_EKF_TYPE 3
# proximity / avoidance under test
AVOID_ENABLE 3
PRX1_TYPE 2
AVOID_MARGIN 0.5
AVOID_BEHAVE 1
# indoor: keep speeds modest so the test is representative of inspection flight
LOIT_SPEED_MS 2.0
# no RC receiver in this setup: throttle failsafe would otherwise trip when overrides stop
FS_THR_ENABLE 0
FS_GCS_ENABLE 0
# avoid wait on compass/baro checks that SITL w/ vision sometimes flaps on
ARMING_CHECK 1
# all flight-mode switch positions = Loiter so RC override never changes mode
FLTMODE1 5
FLTMODE2 5
FLTMODE3 5
FLTMODE4 5
FLTMODE5 5
FLTMODE6 5
